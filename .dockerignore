# Exclude common Python files and directories
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyz
*.pyw
*.pyi
*.egg-info/

# Exclude development and local files
.env
.env.*
*.log
*.db
.DS_Store
.pytest_cache/
.ruff_cache/
.idea/
logs/

# Exclude toolchain/build caches created by scripts/Run-CI.ps1.
# These hold a host-platform Python and a uv package cache; they are
# useless inside the Linux image and add hundreds of MB to the context.
.cache/
.local/
.tmp/
node_modules/
.vscode/
debug/
.codegraph/

# Exclude version control system files
.git/
.gitignore
.svn/

storage/
config.toml
